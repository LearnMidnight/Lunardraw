# The Starfall keeper: opens and reveals draws, computes the numbers, decrypts
# and settles the tickets, finalises, pays winners, voids and refunds late
# draws, and writes the site feed. It uses the same wallet as the v0 keeper,
# so the two never run at once. Edit the network, schedule and paths to match.
# Schedule: --daily closes a draw every day at 20:00 Brisbane; without it,
# Thursdays at 20:00 Brisbane (weekly); --every <seconds> for a fixed period
# (only for a deployment with short windows: --min-sales below the period).
[Unit]
Description=Lunardraw Starfall keeper
After=lunardraw-proof.service network-online.target
Wants=lunardraw-proof.service network-online.target
Conflicts=lunardraw-keeper.service

[Service]
WorkingDirectory=/root/Lunardraw
Environment=HOME=/root
# Today's Blockfrost requests from this service, for the monitor to add up (the daily limit is per project).
Environment=NIGHTCAST_BLOCKFROST_USAGE=/root/lunardraw-status/usage/lunardraw-starfall-keeper.json
ExecStart=/root/Lunardraw/lunardraw starfall keeper --network preprod \
  --organiser /root/lunardraw-secrets/organiser.secret \
  --settlement /root/lunardraw-secrets/settlement.secret \
  --wallet /root/nightcast-secrets/requester-wallet.secret \
  --daily --proof-server-port 6300 \
  --feed /root/lunardraw-feed/feed.json \
  --status /root/lunardraw-status/keeper.json
# Exit code 75 = "restart me" (the watchdog, after transactions kept failing).
Restart=always
RestartSec=15
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
