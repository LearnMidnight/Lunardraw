# The draw oracle for Starfall: answers each revealed draw with Nightcast's VRF.
# Same key and wallet as the v0 oracle, so the two never run at once.
[Unit]
Description=Lunardraw Starfall draw oracle
After=lunardraw-proof.service network-online.target
Wants=lunardraw-proof.service network-online.target
Conflicts=lunardraw-oracle.service

[Service]
WorkingDirectory=/root/Lunardraw
Environment=HOME=/root
# Today's Blockfrost requests from this service, for the monitor to add up (the daily limit is per project).
Environment=NIGHTCAST_BLOCKFROST_USAGE=/root/lunardraw-status/usage/lunardraw-starfall-oracle.json
ExecStart=/root/Lunardraw/lunardraw starfall oracle --network preprod \
  --oracle /root/lunardraw-secrets/oracle.secret \
  --wallet /root/nightcast-secrets/oracle-wallet.secret \
  --proof-server-port 6300 \
  --status /root/lunardraw-status/oracle.json
Restart=always
RestartSec=15
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
