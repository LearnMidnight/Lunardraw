# A Starfall agent: a player with its own wallet that buys into every draw.
# One instance per agent: its wallet is /root/lunardraw-agents/<name>.secret
# (./lunardraw wallet new, funded from the faucet) and its style comes from
# /root/lunardraw-agents/<name>.env, e.g.
#   AGENT_ARGS=--style mix --budget 30
#   AGENT_ARGS=--style lucky --numbers 3,11,17,23,26,30,34 --moonball 7   (commas, not quotes: the
#   value is split on spaces when it reaches the command)
#   AGENT_ARGS=--style lucky --lines 3,11,17,23,26,30,34+7;1,12,21,23,26,31,35+16   (several sets: no spaces)
#   AGENT_ARGS=--style quickpick --games 4 --budget 130 --rounds 24   (an agent started for a while each
#   day by a timer, buying the day's worth at once: every open wallet costs Blockfrost requests)
# Then: systemctl enable --now lunardraw-agent@<name>
# It proves on the player proof server (6301), never the keeper's (6300).
[Unit]
Description=Lunardraw Starfall agent %i
After=lunardraw-player-proof.service network-online.target
Wants=lunardraw-player-proof.service network-online.target

[Service]
WorkingDirectory=/root/Lunardraw
Environment=HOME=/root
# Today's Blockfrost requests from this service, for the monitor to add up (the daily limit is per project).
Environment=NIGHTCAST_BLOCKFROST_USAGE=/root/lunardraw-status/usage/lunardraw-agent-%i.json
EnvironmentFile=-/root/lunardraw-agents/%i.env
ExecStart=/bin/bash -c 'exec /root/Lunardraw/lunardraw starfall agent --network preprod --name %i \
  --wallet /root/lunardraw-agents/%i.secret --proof-server-port 6301 $AGENT_ARGS'
# Exit code 75 = "restart me" (the wallet went stale).
Restart=always
RestartSec=30
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
