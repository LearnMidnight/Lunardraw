}

pure circuit bodySlots(): Vector<12, Field> {
  return [0 as Field, 1 as Field, 2 as Field, 3 as Field, 4 as Field, 5 as Field, 6 as Field, 7 as Field, 8 as Field, 9 as Field, 10 as Field, 11 as Field];
