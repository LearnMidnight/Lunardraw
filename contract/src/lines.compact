  const m8 = t.lines[8].moonball == moonball;
  const h9 = lineHits(t.lines[9], numbers);
  const m9 = t.lines[9].moonball == moonball;
  const h10 = lineHits(t.lines[10], numbers);
  const m10 = t.lines[10].moonball == moonball;
  const g = gamesByDivision(t.entry, numbers, moonball, f);
