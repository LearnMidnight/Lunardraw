// A ticket carries its entry and up to 11 extra standard lines, so it holds
// up to 12 games. Lines are packed three to a field element, so a sealed
// ticket is 12 field elements. Included by settlement.compact after entries.

export pure circuit maxLines(): Uint<8> {
  return 11;
}

// Games in a ticket in a draw of format f: its entry's, plus one per line it uses.
export pure circuit ticketGames(t: TicketPreimage, f: Format): Uint<32> {
  return (gamesIn(t.entry, f)
       + (lineUsed(t.lines[0]) ? 1 : 0)
       + (lineUsed(t.lines[1]) ? 1 : 0)
       + (lineUsed(t.lines[2]) ? 1 : 0)
       + (lineUsed(t.lines[3]) ? 1 : 0)
       + (lineUsed(t.lines[4]) ? 1 : 0)
       + (lineUsed(t.lines[5]) ? 1 : 0)
       + (lineUsed(t.lines[6]) ? 1 : 0)
       + (lineUsed(t.lines[7]) ? 1 : 0)
       + (lineUsed(t.lines[8]) ? 1 : 0)
       + (lineUsed(t.lines[9]) ? 1 : 0)
       + (lineUsed(t.lines[10]) ? 1 : 0)) as Uint<32>;
}

// A ticket's winning games per division (division 1 first): its entry's and
// its lines'. An unused line wins nothing: 0 is never drawn, nor Moonball 0.
export pure circuit ticketDivisions(t: TicketPreimage, numbers: Vector<7, Uint<8>>, moonball: Uint<8>, f: Format): Vector<9, Uint<32>> {
  const h0 = lineHits(t.lines[0], numbers);
  const m0 = t.lines[0].moonball == moonball;
