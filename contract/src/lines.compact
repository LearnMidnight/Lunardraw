// A ticket's lines as field elements, three lines (24 bytes) each.
pure circuit packedLines(t: TicketPreimage): Vector<4, Field> {
  return [
    packLines(t.lines[0], t.lines[1], t.lines[2]),
    packLines(t.lines[3], t.lines[4], t.lines[5]),
    packLines(t.lines[6], t.lines[7], t.lines[8]),
    packLines(t.lines[9], t.lines[10], noLine())
  ];
}

// The lines back from the sealed ticket's last 4 field elements (off-chain, by the settler).
pure circuit unpackLines(f: Vector<12, Field>): Vector<11, Line> {
  const q0 = (f[8] as Bytes<24>) as Vector<24, Uint<8>>;
  const q1 = (f[9] as Bytes<24>) as Vector<24, Uint<8>>;
  const q2 = (f[10] as Bytes<24>) as Vector<24, Uint<8>>;
  const q3 = (f[11] as Bytes<24>) as Vector<24, Uint<8>>;
  return [
    Line { numbers: [q0[0], q0[1], q0[2], q0[3], q0[4], q0[5], q0[6]], moonball: q0[7] },
    Line { numbers: [q0[8], q0[9], q0[10], q0[11], q0[12], q0[13], q0[14]], moonball: q0[15] },
    Line { numbers: [q0[16], q0[17], q0[18], q0[19], q0[20], q0[21], q0[22]], moonball: q0[23] },
    Line { numbers: [q1[0], q1[1], q1[2], q1[3], q1[4], q1[5], q1[6]], moonball: q1[7] },
    Line { numbers: [q1[8], q1[9], q1[10], q1[11], q1[12], q1[13], q1[14]], moonball: q1[15] },
    Line { numbers: [q1[16], q1[17], q1[18], q1[19], q1[20], q1[21], q1[22]], moonball: q1[23] },
    Line { numbers: [q2[0], q2[1], q2[2], q2[3], q2[4], q2[5], q2[6]], moonball: q2[7] },
    Line { numbers: [q2[8], q2[9], q2[10], q2[11], q2[12], q2[13], q2[14]], moonball: q2[15] },
    Line { numbers: [q2[16], q2[17], q2[18], q2[19], q2[20], q2[21], q2[22]], moonball: q2[23] },
