{
  "name": "@nightcast/lotto",
  "version": "0.1.0",
  "description": "Lunardraw v0: Starfall (7 from 35 + a Moonball from 20) on Midnight, with draws from Nightcast's VRF embedded in the contract.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "compact": "compact compile src/lotto.compact src/managed/lotto",
    "compact:fast": "compact compile --skip-zk src/lotto.compact src/managed/lotto",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && cp -R src/managed dist/managed && cp src/*.compact dist/",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "0.16.0",
    "@nightcast/contract": "0.1.0"
  },
  "devDependencies": {
    "@nightcast/sdk": "0.1.0"
  }
}
